# OpenAI
OPENAI_API_KEY=sk-...
OPENAI_TEXT_MODEL=gpt-5.6-luna
OPENAI_IMAGE_MODEL=gpt-image-2
IMAGE_QUALITY=medium

# @sophie.delauney69 — prompt dans src/prompts/sophie.txt
CONTENT_LANGUAGE=français
BRAND_VOICE=naturel, parisien, chaleureux et spontané
EXTRA_INSTRUCTIONS=
POST_INTERVAL_HOURS=24
# Publier aussi la même photo en story après chaque post
PUBLISH_STORIES=true

# Hébergement public : cloudinary pour tester en local, nginx sur le VPS
IMAGE_HOSTING=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Requis uniquement avec IMAGE_HOSTING=nginx
PUBLIC_IMAGE_DIR=/app/public-images
PUBLIC_IMAGE_BASE_URL=https://example.com/instalala-images/

# Instagram Graph API (compte Instagram professionnel)
# Facultatif : le script le récupère automatiquement à partir du token
INSTAGRAM_ACCOUNT_ID=
INSTAGRAM_ACCESS_TOKEN=
META_GRAPH_VERSION=v24.0

# true : génère localement sans publier ; false : publie réellement
DRY_RUN=true

# daily : un post par jour à Paris ; interval : délai POST_INTERVAL_HOURS
POST_SCHEDULE=daily
